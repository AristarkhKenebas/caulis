    <connection>scm:git:https://github.com/AristarkhKenebas/caulis.git</connection>
    <url>https://github.com/AristarkhKenebas/caulis</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>io.github.aristarkhkenebas</groupId>
      <artifactId>caulis-core</artifactId>
      <version>0.1.8</version>
      <scope>compile</scope>
